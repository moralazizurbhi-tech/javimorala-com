---
// i18n/Routing Layer — root bootstrap & redirect (Task Catalog T-006;
// content-localization Technical Design, i18n/Routing Layer
// Responsibilities/Design Decisions 1, 3, 5). Language-agnostic root: no
// visible content of its own (Constraint), only a synchronous,
// render-blocking script resolving the active language via override →
// detected browser locale → English, then redirecting before first paint
// (Commitments 1, 4). `<noscript>` covers the no-JS failure mode
// (Design Decision 3), landing at /en/.
//
// `is:inline` keeps this script exactly as authored — unbundled, not a
// deferred module — so it stays synchronous/blocking regardless of Astro's
// default script handling.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var SUPPORTED = ['en', 'es', 'eu'];
        var FALLBACK = 'en';

        // Resolution priority: override → detected supported locale →
        // English fallback (content-localization Commitment 1).
        function resolveLocale(override, detected) {
          if (SUPPORTED.indexOf(override) !== -1) return override;
          if (SUPPORTED.indexOf(detected) !== -1) return detected;
          return FALLBACK;
        }

        // Stub: always "unset" until Task Catalog T-024 wires
        // language-override's real Override Store as the live read source
        // (Technical Design, Design Decision 5).
        function readOverrideSignal() {
          return 'unset';
        }

        function detectBrowserLocale() {
          var lang = (navigator.language || '').slice(0, 2).toLowerCase();
          return lang;
        }

        var locale = resolveLocale(readOverrideSignal(), detectBrowserLocale());
        location.replace('/' + locale + '/');
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/en/" />
    </noscript>
  </head>
  <body></body>
</html>

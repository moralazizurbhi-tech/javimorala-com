---
// i18n/Routing Layer — per-locale static route (T-006). One fully static,
// complete route per supported language, each pre-rendering that
// language's resolved content/metadata from the Content Layer
// (content-localization/technical-design.md; Commitments 2, 3).
import { getEntry } from 'astro:content';
import RootLayout from '../../layouts/RootLayout.astro';
import HeroComposition from '../../features/hero-presentation/HeroComposition.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../features/content-localization/localeResolution';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: SupportedLocale };

const introduction = await getEntry('introduction', locale);
const description = introduction?.data.placeholder ?? '';
---

<RootLayout lang={locale} title="Javi Morala" description={description}>
	<Fragment slot="introduction">
		<HeroComposition
			headlinePrimary={introduction?.data.headlinePrimary ?? ''}
			headlineSecondaryLine1={introduction?.data.headlineSecondaryLine1 ?? ''}
			headlineSecondaryLine2={introduction?.data.headlineSecondaryLine2 ?? ''}
			scrollCue={introduction?.data.scrollCue ?? ''}
		/>
	</Fragment>
</RootLayout>

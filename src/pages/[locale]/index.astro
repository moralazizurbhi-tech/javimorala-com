---
// i18n/Routing Layer — per-locale static route (T-006). One fully static,
// complete route per supported language, each pre-rendering that
// language's resolved content/metadata from the Content Layer
// (content-localization/technical-design.md; Commitments 2, 3).
import { getEntry } from 'astro:content';
import RootLayout from '../../layouts/RootLayout.astro';
import HeroComposition from '../../features/hero-presentation/HeroComposition.astro';
import AboutNarrativeComposition from '../../features/about-narrative/AboutNarrativeComposition.astro';
import DirectContactComposition from '../../features/direct-contact/DirectContactComposition.astro';
import { SUPPORTED_LOCALES, type SupportedLocale } from '../../features/content-localization/localeResolution';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: SupportedLocale };

const introduction = await getEntry('introduction', locale);
const personalNarrative = await getEntry('personalNarrative', locale);
const connection = await getEntry('connection', locale);
const description = introduction?.data.placeholder ?? '';
---

<RootLayout
	lang={locale}
	title="Javi Morala"
	description={description}
	wordmark={introduction?.data.wordmark ?? ''}
	navLabelAbout={personalNarrative?.data.navLabel ?? ''}
	navLabelContact={connection?.data.navLabel ?? ''}
>
	<Fragment slot="introduction">
		<HeroComposition
			headlinePrimary={introduction?.data.headlinePrimary ?? ''}
			headlineSecondaryLine1={introduction?.data.headlineSecondaryLine1 ?? ''}
			headlineSecondaryLine2={introduction?.data.headlineSecondaryLine2 ?? ''}
			scrollCue={introduction?.data.scrollCue ?? ''}
		/>
	</Fragment>
	<Fragment slot="personal-narrative">
		<AboutNarrativeComposition
			heading={personalNarrative?.data.navLabel ?? ''}
			sectionIntro={personalNarrative?.data.sectionIntro ?? ''}
			paragraphs={[
				personalNarrative?.data.paragraph1 ?? '',
				personalNarrative?.data.paragraph2 ?? '',
				personalNarrative?.data.paragraph3 ?? '',
				personalNarrative?.data.paragraph4 ?? '',
				personalNarrative?.data.paragraph5 ?? '',
				personalNarrative?.data.paragraph6 ?? '',
			]}
			photoPortraitAlt={personalNarrative?.data.photoPortraitAlt ?? ''}
			photoLandscapeAlt={personalNarrative?.data.photoLandscapeAlt ?? ''}
		/>
	</Fragment>
	<Fragment slot="connection">
		<DirectContactComposition
			headingText={connection?.data.headingText ?? ''}
			ctaText={connection?.data.ctaText ?? ''}
			farewellLine1={connection?.data.farewellLine1 ?? ''}
			farewellLine2={connection?.data.farewellLine2 ?? ''}
		/>
	</Fragment>
</RootLayout>

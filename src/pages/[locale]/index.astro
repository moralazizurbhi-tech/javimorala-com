---
// Per-locale static route (Task Catalog T-005; content-localization
// Technical Design, i18n/Routing Layer Responsibilities): generates one
// fully static route per supported language, each pre-rendering that
// language's resolved content/metadata from the Content Layer via
// src/lib/i18n.ts. Hero Composition (T-008) mounts into the
// Introduction slot below; About Narrative and Direct Contact
// Composition (T-009/T-010) will mount into their own Root Layout
// slots the same way.
import RootLayout from '../../layouts/RootLayout.astro';
import HeroComposition from '../../components/HeroComposition.astro';
import { SUPPORTED_LOCALES, resolveLocaleContent, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const { metadata, introduction } = await resolveLocaleContent(locale);
---

<RootLayout lang={locale}>
  <Fragment slot="head">
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
  </Fragment>
  <HeroComposition slot="introduction" introduction={introduction} />
</RootLayout>

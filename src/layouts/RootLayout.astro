---
// Root Layout — composes the three Domain Sections (Introduction,
// Personal Narrative, Connection) in fixed order for a given locale
// route; owns global layout/theme wiring (Task Catalog T-004; Project
// Architecture, System Structure: Root Layout; Component
// Relationships). No client-side router across domains — only
// locale-level routing exists above this layout.
//
// Each Domain Section is an empty placeholder here: later Feature
// tasks (Hero, About Narrative, Direct Contact Composition) mount
// their own content into the matching named slot; this layout does
// not need to change when they do.
interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <slot name="head" />
    <style lang="scss" is:global>
      // Wires T-030's already-built, already-tested global reset/base
      // stylesheet into the one shared layout every locale route renders
      // through — previously compiled and unit-tested in isolation only,
      // never actually loaded by a page (found while visually verifying
      // T-008's Hero Composition: without this, body background/
      // foreground colour never reach the browser, leaving off-white
      // text on a default-white background). Mechanical wiring of prior
      // approved work, not a new styling decision.
      @use '../styles/base/reset';
    </style>
  </head>
  <body>
    <main>
      <section id="introduction" aria-label="Introduction">
        <slot name="introduction" />
      </section>
      <section id="personal-narrative" aria-label="Personal Narrative">
        <slot name="personal-narrative" />
      </section>
      <section id="connection" aria-label="Connection">
        <slot name="connection" />
      </section>
    </main>
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import SectionNav from '../features/section-navigation/SectionNav';
import PresenceLinkGroup from '../features/presence-links/PresenceLinkGroup.astro';
import HeroEntranceIsland from '../features/motion-interaction/HeroEntranceIsland';
import AboutNarrativeRevealIsland from '../features/motion-interaction/AboutNarrativeRevealIsland';
import NavActiveIndicatorIsland from '../features/motion-interaction/NavActiveIndicatorIsland';
import CtaInteractionMotionIsland from '../features/motion-interaction/CtaInteractionMotionIsland';
import type { SupportedLocale } from '../features/content-localization/localeResolution';

interface Props {
  title: string;
  description: string;
  lang: SupportedLocale;
  wordmark: string;
  navLabelAbout: string;
  navLabelContact: string;
}

const { title, description, lang, wordmark, navLabelAbout, navLabelContact } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
	<SectionNav
		client:load
		wordmark={wordmark}
		navLabelAbout={navLabelAbout}
		navLabelContact={navLabelContact}
		activeLocale={lang}
	/>
	<!--
		Nav Active Indicator Transition Island (T-041;
		motion-interaction/technical-design.md) — a wholly separate island,
		never composed inside Section Navigation's own component tree
		(that file's own header comment; Design Decision 1). Rendered here,
		as SectionNav's own sibling, the same integration point
		HeroEntranceIsland/AboutNarrativeRevealIsland already use.
	-->
	<NavActiveIndicatorIsland client:load />
	<main>
		<section id="introduction" class="introduction">
			<!--
				Hero Entrance & Ambient Motion Island (T-019;
				motion-interaction/technical-design.md) — hydrates around Hero
				Composition's and Presence Links' already-rendered static markup
				(static-children-in-island pattern), targeting both by class from
				inside. Wraps them together, not just Hero's own slot, since
				Presence Links' first-load entrance beat (Commitment 2 AC3) needs
				this island to reach it too. Never alters either's own markup.
			-->
			<HeroEntranceIsland client:load>
				<slot name="introduction" />
				<!--
					Presence Links' Introduction placement (T-018; presence-links
					Commitment 4 AC1; hero-presentation Commitment 5) — composed here,
					at the Introduction Domain Section level, as a sibling of Hero
					Composition, never inside it (Hero's own Commitment 5 AC5: this
					Feature doesn't decide Presence Links' content). Single shared
					component (T-017), instantiated identically at both placements.
				-->
				<div class="introduction__presence-links">
					<PresenceLinkGroup />
				</div>
			</HeroEntranceIsland>
		</section>
		<section id="personal-narrative">
			<!--
				About Narrative Reveal Island (T-020;
				motion-interaction/technical-design.md) — hydrates around About
				Narrative Composition's already-rendered static markup
				(static-children-in-island pattern), targeting its paragraphs/
				photos by class from inside. Never alters that file's own markup.
			-->
			<AboutNarrativeRevealIsland client:load>
				<slot name="personal-narrative" />
			</AboutNarrativeRevealIsland>
		</section>
		<section id="connection">
			<!--
				CTA Interaction Motion Island (T-023;
				motion-interaction/technical-design.md) — hydrates around Direct
				Contact Composition's already-rendered static markup
				(static-children-in-island pattern), targeting its CTA anchor
				(`.contact__cta`) by class from inside. Wraps the whole connection
				slot (matching Hero's/About Narrative's own wrapping granularity,
				which likewise wrap their full domain-section slot rather than a
				single element), but only ever queries/mutates the CTA anchor
				itself — the heading, farewell lines, and Presence Links sharing
				this subtree are never touched. Never alters
				DirectContactComposition.astro's own file.
			-->
			<CtaInteractionMotionIsland client:load>
				<slot name="connection" />
			</CtaInteractionMotionIsland>
		</section>
	</main>
</BaseLayout>

<style lang="scss">
	@use '../styles/tokens' as tokens;
	@use '../styles/mixins' as mixins;

	// Global theme (T-004) — brand colour/typography applied at the root,
	// on top of T-001's reset. :global(body) is required since BaseLayout
	// owns <body> in a separate component; Root Layout owns the theme.
	:global(body) {
		background-color: tokens.$color-base-bg;
		color: tokens.$color-base-fg;
		font-family: tokens.$font-family-body;
		font-weight: tokens.$font-weight-body;
		line-height: tokens.$line-height-body;
	}

	// Section Navigation renders a fixed bar on every device class — the
	// desktop bar (T-011) from the desktop breakpoint up, the mobile
	// closed-state bar (T-012) below it. Anchor-link jumps (Commitment 2;
	// Commitment 6 AC2 from inside the mobile overlay) must land clear of
	// whichever is present, not underneath it — these values must match
	// SectionNav.module.scss's own $mobile-nav-height / $nav-height.
	:global(#introduction),
	:global(#personal-narrative),
	:global(#connection) {
		scroll-margin-top: 3rem;

		@include mixins.desktop-up {
			scroll-margin-top: 4.5rem;
		}
	}

	// Introduction Domain Section — position: relative anchor for Presence
	// Links' absolutely-positioned corner placement below (T-018). Hero
	// Composition itself (this section's other child) already establishes
	// the section's own 100vh/100dvh height; nothing here changes that.
	.introduction {
		position: relative;
	}

	// Bottom-left corner, mirroring Hero's own scroll cue's bottom-right
	// placement (hero-presentation/ui.md, Spacing and Layout: "an
	// intentional bottom-row symmetry, each equally distant from its
	// respective corner") — same inset values as Hero's own padding
	// (space-lg vertical, space-md horizontal), since this box coincides
	// with Hero's own padded box. Desktop/tablet only: no mobile
	// realization exists for this placement (hero-presentation Commitment
	// 5 AC2; presence-links/ui.md, Mobile — Introduction placement).
	.introduction__presence-links {
		display: none;

		@include mixins.desktop-up {
			display: block;
			position: absolute;
			left: tokens.$space-md;
			bottom: tokens.$space-lg;
		}
	}

	// Pre-hide guard for Hero's entrance (motion-interaction/T-019,
	// post-implementation correction) — BaseLayout.astro's blocking
	// script toggles this class on <html> before the body below is even
	// parsed, so these elements start hidden at first paint instead of
	// flashing fully visible for the moment before HeroEntranceIsland
	// hydrates and hides them itself via JS. Values here must stay in
	// sync with HeroEntranceIsland.tsx's own hidden state (MARK_CLIP_HIDDEN,
	// ENTRANCE_Y_OFFSET) — this is the same hidden state, just applied a
	// moment earlier, via CSS instead of JS. Never baked into
	// HeroComposition.astro's own file, and never able to hide anything
	// permanently: BaseLayout's script only adds this class when JS is
	// actually running (so completeness holds under no-JS) and removes
	// it itself a few seconds later regardless, in case the island never
	// hydrates.
	:global(html.js-hero-entrance-pending) {
		:global(.hero__mark) {
			opacity: 0;
			clip-path: inset(0 50% 0 50%);
		}

		:global(.hero__headline-primary) {
			opacity: 0;
		}

		:global(.hero__headline-secondary--1),
		:global(.hero__headline-secondary--2) {
			opacity: 0;
			transform: translateY(12px);
		}

		:global(.hero__scroll-cue),
		:global(.introduction__presence-links) {
			opacity: 0;
			transform: translateY(12px);
		}
	}
</style>

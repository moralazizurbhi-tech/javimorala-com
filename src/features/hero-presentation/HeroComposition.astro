---
// Hero Composition (T-009) — hero-presentation/technical-design.md.
// Purely static, no client-side hydration: none of Commitments 1-3 need
// runtime state. Headline/tagline/scroll-cue text is passed in already
// resolved by the i18n/Routing Layer (the active route's locale) — this
// component never reads the Content Layer or decides the language itself
// (Commitment 2). All three composition elements render together in one
// template, unconditionally, so completeness (Commitment 1) is
// structurally guaranteed rather than sequenced at runtime. The scroll
// cue is plain, non-focusable markup — no button/link/tabindex — since
// activating it must have no effect (Commitment 3).
interface Props {
	headlinePrimary: string;
	headlineSecondaryLine1: string;
	headlineSecondaryLine2: string;
	scrollCue: string;
}

const { headlinePrimary, headlineSecondaryLine1, headlineSecondaryLine2, scrollCue } = Astro.props;
---

<div class="hero">
	<div class="hero__display">
		<img class="hero__mark" src="/ornamental-mark.svg" alt="" aria-hidden="true" />
		<span id="hero-mark-boundary" class="hero__mark-boundary" aria-hidden="true"></span>
		<h1 class="hero__headline">
			<span class="hero__headline-primary">{headlinePrimary}</span>
			<span class="hero__headline-secondary-group">
				<span class="hero__headline-secondary hero__headline-secondary--1">{headlineSecondaryLine1}</span>
				<span class="hero__headline-secondary hero__headline-secondary--2">{headlineSecondaryLine2}</span>
			</span>
		</h1>
	</div>
	<p class="hero__scroll-cue">
		<span>{scrollCue}</span>
		<svg class="hero__scroll-cue-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
			<path d="M12 4v14m0 0-6-6m6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</p>
</div>

<style lang="scss">
	@use '../../styles/tokens' as tokens;
	@use '../../styles/mixins' as mixins;

	// Device-class layout (T-010, Commitment 4) — one shared markup, CSS-only
	// branching via the desktop-up breakpoint mixin (Technical Design,
	// Design Decisions). Base rules below are the mobile treatment; the
	// desktop-up include overrides them with a purpose-built desktop/tablet
	// treatment, not a scaled/wrapped copy of it (ui.md, Spacing and Layout).
	.hero {
		position: relative;
		isolation: isolate;
		// Mobile's mark (below) is rotated and bleeds off two edges by
		// design (ui.md, Mobile; Figma's own mobile frame) — contains that
		// bleed instead of letting it force horizontal page scroll.
		overflow: hidden;
		// `100dvh` (falls back to `100vh` on browsers that don't support
		// it) — plain `100vh` resolves against mobile browsers' *large*
		// viewport (address bar hidden), which is taller than what's
		// actually visible on first paint (address bar shown), pushing the
		// bottom `auto` grid row (scroll cue) below the real visible fold —
		// developer visual review finding on a real device.
		min-height: 100vh;
		min-height: 100dvh;
		padding: tokens.$space-lg tokens.$space-md;
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: 1fr auto;
		grid-template-areas:
			'headline'
			'cue';

		@include mixins.desktop-up {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'headline headline'
				'.        cue';
		}
	}

	// Groups the mark and the headline as one visual unit so they move
	// together as a single element (developer direction: "the Building
	// [and] the ornament... both as one element" must sit centered on the
	// page) — previously the mark was pinned near `.hero`'s own top edge
	// independently of the headline's own vertical centering, so the pair
	// read as two separately-placed things rather than one composition,
	// and their combined visual center sat above the page's true middle.
	// Not present on desktop-up: the mark and headline already have their
	// own independently-tuned, approved absolute positions there (see
	// each's own desktop-up rules below) — `display: contents` un-wraps
	// this element for layout there, restoring exactly that prior
	// structure instead of grouping them.
	.hero__display {
		grid-area: headline;
		position: relative;
		align-self: center;
		min-width: 0;

		// `.hero__mark` (below) is `position: absolute`, so on its own it
		// contributes nothing to `.hero__display`'s normal-flow height —
		// `align-self: center` above would then only center the headline's
		// own (much smaller) height, leaving the mark to bleed upward from
		// wherever *that* lands, independent of the mark's own real size
		// (confirmed via screenshot: the combined group still read as
		// top-heavy after grouping alone). This spacer reserves flow space
		// approximating the mark's own rotated bounding-box height, so the
		// browser's centering math accounts for the *combined* group
		// instead of just the headline.
		//
		// `.hero__mark` itself is anchored at `top: 0` (unrotated box), so
		// what matters here isn't the rotated box's *total* bounding height
		// but how far its visual bottom edge sits *below that anchor* —
		// rotation happens around the box's own center, so only about half
		// of the bounding-box growth extends downward from `top: 0`, the
		// other half bleeding upward off-screen (clipped by `.hero`'s
		// `overflow: hidden`). First attempt used the full bounding height
		// here and left a large dead gap above the headline (visually
		// confirmed wrong) before this was corrected.
		//
		// Developer-specified directly (was a derived formula from the
		// mark's own rotated bounding-box geometry, halved and reduced
		// through several rounds of "still too far apart" feedback) — kept
		// in sync with `.hero__mark`'s own `width` below by hand, since a
		// shared Sass variable can't cross into a pseudo-element's
		// generated box from here cleanly. Mobile-only: on desktop-up,
		// `display: contents` on `.hero__display` itself removes *its own*
		// box, but does NOT suppress this pseudo-element's box — it still
		// generates one, now promoted to participate directly in `.hero`'s
		// own desktop grid alongside the (position: absolute, so otherwise
		// invisible to grid sizing) mark and headline. Being the only
		// *normal-flow* item landing in the grid's 'headline' row/column,
		// its 68vw height forced that row to grow to fit it — pushing the
		// whole composition around on desktop (developer visual review:
		// "the heading moved up... the wrong placement is because of the
		// :before"). `content: none` fully suppresses the pseudo-element
		// there instead of merely hiding it, so it doesn't participate in
		// layout at all.
		&::before {
			content: '';
			display: block;
			width: 100%;
			height: 68vw;

			@include mixins.desktop-up {
				content: none;
			}
		}

		@include mixins.desktop-up {
			display: contents;
		}
	}

	// Background-layer ornamental mark — shared static SVG asset (Figma
	// "Porifolio" file, "Metal logogogog 1"; shape traced from that
	// reference, gradient corrected to Figma's own literal colour values
	// — #F5D8FC fading to #F0D8FC at 5% opacity — after a developer
	// visual review found the prior lilac-to-purple recolouring didn't
	// match the source). Its own visual design is a shared substrate,
	// not owned by this Feature (technical-design.md, Dependencies) —
	// only placement/crop/z-order below are this Feature's concern.
	// Mobile: cropped toward the top-right, bleeding off the right edge.
	// Desktop/tablet: centered, with a small top offset (below) so its
	// crown isn't flush against the very top of the viewport, and
	// `object-fit: contain` so the full artwork stays visible instead of
	// cropping its lower portion (developer visual review finding) — a
	// distinct crop per device class, not a scaled copy (ui.md).
	.hero__mark {
		position: absolute;
		z-index: -1;
		// Figma's own mobile frame ("Home - mobile") doesn't crop the
		// artwork's own proportions at all — it rotates the whole mark
		// (45° clockwise/downward, developer-confirmed against Figma — the
		// first attempt had the direction reversed) and scales it down, so
		// almost the entire shape stays visible; only a small amount bleeds
		// past the frame's own edges, clipped by `.hero`'s `overflow:
		// hidden` above (developer visual review finding — the earlier
		// square-crop-window approach cropped the artwork's own aspect
		// ratio instead, and was still an unrotated fragment).
		// `aspect-ratio` matches the source SVG's own viewBox (1216×780)
		// exactly, so `object-fit: contain` has no leftover space to
		// reposition within — nothing for `object-position` to do, and
		// nothing here to leak into the desktop-up override below.
		// `top: 0`, flush at `.hero__display`'s own top edge — which is
		// also the spacer's (`.hero__display::before`, above) own top
		// edge, so the mark visually fills the space the spacer reserves,
		// with the headline starting right where the spacer ends —
		// giving the tendrils a deliberate overlap into the headline's
		// own space for "genuine interleaving" (ux.md). Tried `bottom:
		// 100%` first: that measures against `.hero__display`'s *entire*
		// height (spacer + headline together, since both are inside the
		// same containing block), landing the mark's bottom at the
		// spacer's own top instead of its bottom — a full spacer-height
		// gap above the headline (visually confirmed wrong).
		// Width/right developer-specified directly, tuned by eye against
		// their own build (was 150vw / -52%, itself already widened once
		// from 115vw / -32% for the same "reach the left edge" reason).
		top: 0;
		right: -30%;
		width: 127vw;
		aspect-ratio: 1216 / 780;
		height: auto;
		object-fit: contain;
		transform: rotate(45deg);
		pointer-events: none;

		@include mixins.desktop-up {
			// A small breathing-room offset instead of sitting flush on the
			// viewport's own top edge — still comfortably tall enough (70vh)
			// to visually reach the nav row above it, per ux.md's Feature
			// Components ("top-anchored height is tall enough to visually
			// reach the nav row"), which this modest offset doesn't disturb.
			top: tokens.$space-md;
			left: 50%;
			right: auto;
			width: 70vw;
			height: 70vh;
			// `contain`, not `cover`: guarantees the full artwork renders
			// within its box on every viewport aspect ratio, rather than
			// `cover` cropping whichever dimension the box exceeds the
			// artwork's own proportions in (developer visual review found
			// the mark's bottom portion cropped away under `cover`).
			object-fit: contain;
			transform: translateX(-50%);
		}
	}

	// Mark-visibility sentinel (technical-design.md, Collaborations) — a
	// passive marker at the Ornamental Mark's own effective lower
	// boundary. Positioned to track `.hero__mark`'s own box bottom edge
	// on each device class (top offset + height), so it stays accurate
	// even though desktop now carries a small top offset mobile doesn't.
	// Section Navigation observes this the same way it already observes
	// Domain Section boundaries, to drive its own divider-line
	// segmented/continuous state (section-navigation Contract Commitment
	// 8) — this component has no knowledge of, or dependency on, that
	// consumer.
	.hero__mark-boundary {
		position: absolute;
		top: 70vh;
		left: 0;
		width: 100%;
		height: 1px;
		pointer-events: none;

		@include mixins.desktop-up {
			top: calc(#{tokens.$space-md} + 70vh);
		}
	}

	.hero__headline {
		// Mobile: a plain block child of `.hero__display` (which is the
		// thing centered and grid-placed now — see above); its own
		// `min-width: auto` (a grid container, so still a candidate for
		// the same nested-track blowout the secondary elements needed
		// `min-width: 0` for internally) is defensively reset here too.
		min-width: 0;
		display: grid;
		// Tightened twice (was $space-md, then $space-xs) — the dominant
		// word and the secondary lines kept reading as too far apart
		// (developer visual review); the dominant word's own column is
		// the one that moves closer, since the secondary column's own
		// left edge is what the text below it is anchored against.
		column-gap: calc(#{tokens.$space-xs} / 2);
		row-gap: tokens.$space-xs;
		// Mobile-only left offset (developer direction) — reset to 0 on
		// desktop-up below, where the headline is independently
		// absolutely-positioned against the mark's own geometry and
		// doesn't need this.
		margin: 0 0 0 1rem;
		font-family: tokens.$font-family-heading;
		font-weight: tokens.$font-weight-display;
		letter-spacing: tokens.$letter-spacing-heading;
		// Pascal Case — every word's first letter capitalized — per
		// developer direction, applied via CSS rather than editing each
		// locale's own content string, so it holds uniformly across
		// English/Spanish/Euskera without this Feature re-deciding
		// per-language capitalization rules. Declared on each individual
		// span below (.hero__headline-primary/-secondary), not here: every
		// span is `position: absolute`, so the whitespace between two
		// out-of-flow siblings collapses away entirely, and the build's
		// CSS minifier strips an inherited-and-redundant-looking
		// declaration here as dead weight — except it isn't redundant,
		// since the browser's capitalize computation then sees each
		// span's own first letter as a continuation of the previous
		// span's last word rather than a new word. Declaring it per-span
		// keeps it un-minifiable-away and makes each span's own
		// computation self-contained.
		color: tokens.$color-base-fg;

		// Mobile: dominant word anchored to the left edge, both secondary
		// lines stacked to its right (ui.md, Mobile), grouped into one grid
		// cell — not two separate auto rows: with a spanning sibling (the
		// dominant word, spanning the full row height), a two-row track
		// forced the browser to distribute the dominant word's extra
		// height across both rows, inflating the gap between the two
		// secondary lines well past their own natural line-height
		// (developer visual review). One shared cell sizes to the taller
		// of the two children (the dominant word), and the group wrapper
		// itself (below) stacks its own two children tightly via flex —
		// two grid items simply assigned the same grid-area overlap
		// instead of flowing in sequence (tried first; visually confirmed
		// wrong), which is exactly why the group needs its own wrapper
		// element. Bottom-aligned (not centered): the second secondary
		// line's own bottom edge lines up with the dominant word's bottom
		// edge (developer visual review, checked against Figma's mobile
		// frame).
		grid-template-columns: auto 1fr;
		grid-template-rows: auto;
		grid-template-areas: 'primary secondary';
		align-items: end;

		@include mixins.desktop-up {
			// Desktop/tablet: sized and centered to exactly match
			// `.hero__mark`'s own box (left: 50%, width: 70vw, same
			// translateX), not left as a plain full-width grid — so the
			// children's percentage-based positions below resolve against
			// the mark's own geometry, not the viewport. This is what makes
			// the headline/mark relationship hold "independent of desktop
			// size" (developer review): both scale together from the same
			// 70vw reference, instead of the mark scaling on its own while
			// the headline anchored to the viewport's/grid's own edges.
			display: block;
			position: absolute;
			left: 50%;
			width: 70vw;
			margin-left: 0;
			transform: translateX(-50%);
			// Anchored to the mark's own inked geometry, not its crop box's
			// bottom edge (70vh) — the artwork's own tendrils taper off and
			// stop well before that edge (ux.md: "the mark's left tendrils
			// reach into its upper region... genuine interleaving"), so
			// anchoring at the box edge left a dead gap between mark and
			// headline instead of the described overlap. Pulled up so the
			// dominant group's upper glyphs sit within the tendrils' own
			// reach; offset by the mark's own top margin (above) so the
			// relationship holds regardless of that margin's exact value.
			top: calc(#{tokens.$space-md} + 52vh);
		}
	}

	.hero__headline-primary {
		grid-area: primary;
		font-size: tokens.$font-size-display;
		line-height: 1;
		// Correctly capitalized without `::first-letter` since this is the
		// first span in the headline (no preceding sibling's text to
		// wrongly merge with) — see .hero__headline-secondary for the
		// cross-sibling case that does need it.
		text-transform: capitalize;

		// Mobile: "Building" rotated 90°, reading bottom-to-top (ui.md,
		// Mobile). Desktop/tablet: upright, the dominant display line.
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		// Tighter than the shared heading tracking (-0.06em) inherited from
		// `.hero__headline` — developer direction, matching the same
		// tightening already applied to the dominant word specifically on
		// desktop-up (below).
		letter-spacing: -0.09em;

		@include mixins.desktop-up {
			writing-mode: horizontal-tb;
			transform: none;
			// 25.1% — measured directly from the production SVG asset's
			// own geometry (getBBox() on its lowest-reaching left path):
			// the left descending tendril cluster's own lowest point sits
			// at x=304.9 of the 1216-wide viewBox. Inset slightly (to 12%)
			// so the dominant word's own span genuinely overlaps that
			// tendril position rather than starting exactly at its tip —
			// "shares close to the same horizontal span" (ui.md), not a
			// bare touch.
			position: absolute;
			left: 12%;
			top: 0;
			// A little tighter than the shared heading tracking above —
			// developer direction, scoped to the dominant word specifically.
			letter-spacing: -0.09em;
		}
	}

	// Purely presentational grouping — no semantic meaning of its own —
	// so the two secondary lines' mutual spacing (mobile) is explicit
	// flex stacking rather than left to CSS Grid's own row-distribution
	// behavior (see .hero__headline above).
	.hero__headline-secondary-group {
		grid-area: secondary;
		display: flex;
		flex-direction: column;
		min-width: 0;

		@include mixins.desktop-up {
			// Un-wraps for layout purposes: the two lines go back to being
			// independently `position: absolute` against `.hero__headline`
			// itself (their own desktop-up rules, below), exactly as before
			// this wrapper existed.
			display: contents;
		}
	}

	.hero__headline-secondary {
		// Derived directly from the primary size (not the shared
		// $font-size-heading token) so the two stay in a fixed ratio,
		// close to Figma's own measured ratio — a Hero-local relationship,
		// deliberately not coupled to $font-size-heading, which stays free
		// for other Features' own future section headings. Mobile's own
		// divisor is wider than desktop-up's (below): Figma's mobile frame
		// implies a similar ratio to desktop's, but at mobile's much
		// narrower available column width, desktop's own ratio produced
		// text (in every locale, not just English) wider than the space
		// next to the dominant rotated word — this divisor keeps it
		// comfortably within that column, "filling" it with margins rather
		// than overflowing past the viewport edge (developer visual
		// review). Eased down from /3.4 — developer direction, tuned so
		// the mobile-end of this calc lands around 24px (at
		// $font-size-display's own 4rem/64px mobile-end: 64/2.667≈24px).
		font-size: calc(#{tokens.$font-size-display} / 2.667);
		line-height: 1.1;
		// Grid items default to `min-width: auto` (their own unwrapped
		// max-content width), which lets long copy overflow straight past
		// the 1fr column and off the viewport edge instead of wrapping
		// within it — confirmed via visual review (English copy alone
		// overflowed at the ratio above before this was added). `0`
		// restores normal text-wrapping behavior within the column.
		min-width: 0;
		// `text-transform: capitalize`'s word-boundary detection runs over
		// the *rendered text sequence*, not per element — confirmed via an
		// isolated repro — so when a preceding sibling span is also
		// `position: absolute`, the whitespace between them is used-value
		// -collapsed away entirely, and capitalize sees no separator: the
		// first letter of this span reads as a continuation of the
		// previous span's last word, not a new word (declaring the
		// property again on this element, tried first, did not fix it —
		// the word-run computation ignores which element owns the
		// declaration). `::first-letter` below is unambiguous instead: it
		// targets this element's own first rendered character directly,
		// independent of any preceding sibling's text.
		text-transform: capitalize;

		&::first-letter {
			text-transform: uppercase;
		}

		@include mixins.desktop-up {
			// Desktop/tablet's own available width (a 70vw-wide headline
			// box, not mobile's narrow column beside a vertical word) fits
			// Figma's own measured ratio (185:60 ≈ 3.08x) comfortably —
			// sized up slightly from that exact ratio per developer
			// direction ("a little bit bigger").
			font-size: calc(#{tokens.$font-size-display} / 2.6);
		}
	}

	// Shared vertical offset for both secondary lines — kept in one place
	// so "the web" and "with a rebellious streak" stay level with each
	// other (ui.md) even as this value is tuned.
	$secondary-top-offset: calc(#{tokens.$font-size-display} * 0.85);

	.hero__headline-secondary--1 {
		// Mobile: a flex item of .hero__headline-secondary-group, first in
		// source/flex order — no placement of its own needed here.

		@include mixins.desktop-up {
			// Same left anchor as the primary word, directly below it —
			// together they form the "dominant word group" the left
			// tendril cluster reaches into (ui.md). Tightened from the
			// primary word's own full font-size (developer direction: less
			// vertical spacing between "Building" and "the web").
			position: absolute;
			left: 12%;
			top: $secondary-top-offset;
		}
	}

	.hero__headline-secondary--2 {
		// Mobile: a flex item of .hero__headline-secondary-group, second in
		// source/flex order, directly beneath --1.

		@include mixins.desktop-up {
			// 24.7% from the right — measured the same way as the primary
			// word's own anchor above: the right tendril's lowest point
			// sits at x=916.1 of 1216 (75.3% from the left, i.e. 24.7% from
			// the right). Inset to 12% from the right edge for the same
			// overlap reason. Roughly level with the "the web" line above
			// (ui.md), via the same top offset.
			position: absolute;
			right: 12%;
			top: $secondary-top-offset;
		}
	}

	// Passive affordance only — plain text, no interactive semantics
	// (Commitment 3: activating it must never scroll or navigate).
	// Bottom-right on both device classes (developer direction: same
	// corner as desktop, not centered) — no device-class difference here,
	// unlike most of this component's other treatments.
	.hero__scroll-cue {
		grid-area: cue;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: tokens.$space-xs;
		margin: 0;
		// Grid items default to `min-width: auto` (their own unwrapped
		// content width) — with `justify-content: center` this never
		// visibly overflowed the 'cue' track, but flex-end exposed it: the
		// track blew out past the viewport edge and `.hero`'s own
		// `overflow: hidden` (added this round for the mark's bleed)
		// silently clipped the text instead of causing visible scroll.
		min-width: 0;
		font-family: tokens.$font-family-body;
		font-size: tokens.$font-size-caption;
		font-weight: tokens.$font-weight-label;
		color: tokens.$color-base-fg;
	}

	.hero__scroll-cue-icon {
		width: 1em;
		height: 1em;
	}
</style>
